# Regenerate with: vhs assets/demo.tape
Output assets/demo.gif

Set Shell bash
Set FontSize 15
Set Width 1240
Set Height 620
Set Padding 24
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set TypingSpeed 40ms
Set Framerate 20
Env JIGGLE_EVERY "99999"

Hide
Type `export PS1='~/work $ '; clear`
Enter
Show

Type "# Nov 19, 9:01am. Controller charged. Manager online."
Sleep 700ms
Enter
Type "/gta-6"
Sleep 300ms
Ctrl+U
Type "./skills/gta-6/busy.command"
Sleep 300ms
Enter
Sleep 16s
Ctrl+C
Sleep 5s
