# Regenerate with: vhs assets/demo.tape
Output assets/demo.gif

Set Shell bash
Set FontSize 15
Set Width 1240
Set Height 700
Set Padding 24
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set TypingSpeed 40ms
Set Framerate 12
Env GTA6_NUDGE_EVERY "99999"
Env GTA6_CLOCK_OUT "off"
Env GTA6_LUNCH "off"
Env GTA6_DEMO "1"

Hide
Type `export PS1='~/work $ '; clear`
Enter
Show

Type "# Nov 19, 9:01am. Controller charged. Manager online."
Sleep 700ms
Enter
Type "/gta-6"
Sleep 300ms
Ctrl+U
Type "./skills/gta-6/busy.command"
Sleep 300ms
Enter
Sleep 18s
Ctrl+C
Sleep 5s
